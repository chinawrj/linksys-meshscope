#!/bin/sh
#
# Minimal owner-controlled BLE exact-Parent proof handler for Linksys MX4200
# and MX5300 extracted root filesystems. This is invoked only by the btjnap
# hook documented beside this file; it never scans, connects, uploads, or
# flashes anything itself.

set -u

AUTH=
JSON=

while getopts ":u:j:" opt; do
    case "$opt" in
        u) AUTH=$OPTARG ;;
        j) JSON=$OPTARG ;;
        *) exit 2 ;;
    esac
done

JSONPARSE_BIN=${MESHSCOPE_JSONPARSE_BIN:-/usr/bin/jsonparse}
JNAP_CGI=${MESHSCOPE_JNAP_CGI:-/www/JNAP/index.cgi}
SYSEVENT_BIN=${MESHSCOPE_SYSEVENT_BIN:-/sbin/sysevent}

respond_error()
{
    printf '{"result":"%s"}\n' "$1"
    exit 0
}

json_value()
{
    printf '%s' "$JSON" | "$JSONPARSE_BIN" "$1" 2>/dev/null
}

[ -n "$AUTH" ] || respond_error "_ErrorUnauthorized"
[ -n "$JSON" ] || respond_error "ErrorInvalidInput"

# Reuse the stock privileged Action so this proof accepts the same synchronized
# administrator Basic header as ordinary configured-Node JNAP calls.
export JNAP_CGI_MODULES_PATH="/JNAP/modules/wan"
export REQUEST_METHOD="POST"
export REQUEST_URI="/JNAP"
export HTTP_X_JNAP_ACTION="http://linksys.com/jnap/core/CheckAdminPassword"
export HTTP_X_JNAP_AUTHORIZATION="$AUTH"
export JSON_DATA="{}"
export CONTENT_LENGTH=2

AUTH_RESPONSE=$(printf '%s' "$JSON_DATA" | "$JNAP_CGI" 2>/dev/null)
AUTH_RESULT=$(printf '%s' "$AUTH_RESPONSE" |
    "$JSONPARSE_BIN" result 2>/dev/null)
[ "$AUTH_RESULT" = "OK" ] || respond_error "_ErrorUnauthorized"

BAND=$(json_value band)
CHANNEL=$(json_value channel)
BSSID=$(json_value bssid | tr '[:upper:]' '[:lower:]')

case "$BAND" in
    5GL|5GH) ;;
    *) respond_error "ErrorInvalidInput" ;;
esac

case "$CHANNEL" in
    ""|*[!0-9]*) respond_error "ErrorInvalidInput" ;;
esac
[ "$CHANNEL" -ge 1 ] 2>/dev/null || respond_error "ErrorInvalidInput"
[ "$CHANNEL" -le 196 ] 2>/dev/null || respond_error "ErrorInvalidInput"

printf '%s\n' "$BSSID" |
    grep -Eq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' ||
    respond_error "ErrorInvalidInput"

"$SYSEVENT_BIN" set mqttsub::bh_channel "$CHANNEL" ||
    respond_error "ErrorUnexpected"
"$SYSEVENT_BIN" set mqttsub::bh_bssid "$BSSID" ||
    respond_error "ErrorUnexpected"
"$SYSEVENT_BIN" set backhaul::set_intf "$BAND" ||
    respond_error "ErrorUnexpected"

printf '{"result":"OK","output":{"accepted":true,"band":"%s","channel":%s,"bssid":"%s"}}\n' \
    "$BAND" "$CHANNEL" "$BSSID"
